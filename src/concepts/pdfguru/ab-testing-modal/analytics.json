{
  "version": 2,
  "product": "pdfguru",
  "concept": "ab-testing-modal",
  "events": [
    {
      "id": "evt_1",
      "page": "screen",
      "category": "navigation",
      "trigger": "page_view",
      "event": "compress_modal_view",
      "data": {
        "feature_name": "compress",
        "screen_config_name": "quality_picker"
      },
      "notes": "Modal opened — one page-view per render of the compress quality picker."
    },
    {
      "id": "evt_2",
      "page": "screen",
      "category": "interaction",
      "trigger": "click",
      "event": "compress_level_tap",
      "data": {
        "feature_name": "compress",
        "method": "level_select"
      },
      "element": {
        "tag": "button",
        "role": null,
        "label": "Compression level option"
      },
      "notes": "User selects a preset (High/Medium/Low) or Custom row."
    },
    {
      "id": "evt_3",
      "page": "screen",
      "category": "form",
      "trigger": "change",
      "event": "compress_custom_change",
      "data": {
        "feature_name": "compress",
        "method": "custom_slider"
      },
      "element": {
        "tag": "input",
        "role": "slider",
        "label": "Adjust compression level"
      },
      "notes": "User drags the always-visible custom quality slider."
    },
    {
      "id": "evt_4",
      "page": "screen",
      "category": "interaction",
      "trigger": "click",
      "event": "compress_confirm_tap",
      "data": {
        "feature_name": "compress",
        "method": "cta"
      },
      "element": {
        "tag": "button",
        "role": null,
        "label": "Compress to {size}"
      },
      "notes": "Primary CTA — confirms compression with the selected level."
    },
    {
      "id": "evt_5",
      "page": "screen",
      "category": "interaction",
      "trigger": "click",
      "event": "compress_close_tap",
      "data": {
        "feature_name": "compress",
        "method": "close"
      },
      "element": {
        "tag": "button",
        "role": null,
        "label": "Close"
      },
      "notes": "User dismisses the modal via the close (X) button."
    }
  ]
}
